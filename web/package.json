{
  "name": "unbubble-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unbubble's interface and SDK: export iPhone messages on Windows, standalone or embedded in a site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:app": "tsc -b && vite build --mode app --outDir ../helper/unbubble/ui --emptyOutDir"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
